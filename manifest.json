{
  "name": "Pay Time Calculator",
  "short_name": "Pay Time",
  "description": "Track your earnings in real time while you work.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f6f5f2",
  "theme_color": "#1b1d1f",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    {
      "name": "Start session",
      "short_name": "Start",
      "description": "Start the timer for your last-selected pay profile",
      "url": "./index.html?action=start",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Stop session",
      "short_name": "Stop",
      "description": "Stop the running session and save it to history",
      "url": "./index.html?action=stop",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
